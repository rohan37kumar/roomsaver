#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

// ---- Icon (generated by tools/make_icon.py) --------------------------------
IDI_APP ICON "roomsaver.ico"

// ---- Name shown in Windows' Screen Saver Settings dropdown -----------------
STRINGTABLE
BEGIN
    IDS_DESCRIPTION "RoomSaver"
END

// ---- Version info (Explorer: Properties -> Details) ------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ROOMSAVER_VERSION_MAJOR, ROOMSAVER_VERSION_MINOR, ROOMSAVER_VERSION_PATCH, 0
 PRODUCTVERSION ROOMSAVER_VERSION_MAJOR, ROOMSAVER_VERSION_MINOR, ROOMSAVER_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      ROOMSAVER_AUTHOR
            VALUE "FileDescription",  "RoomSaver - music-reactive isometric room screensaver"
            VALUE "FileVersion",      ROOMSAVER_VERSION_STRING
            VALUE "InternalName",     "RoomSaver"
            VALUE "LegalCopyright",   ROOMSAVER_COPYRIGHT
            VALUE "OriginalFilename", "RoomSaver.exe"
            VALUE "ProductName",      "RoomSaver"
            VALUE "ProductVersion",   ROOMSAVER_VERSION_STRING
            VALUE "Comments",         ROOMSAVER_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_CONFIG DIALOGEX 0, 0, 300, 290
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RoomSaver Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Framed picture (shown in the room):", IDC_STATIC, 10, 8, 220, 10
    EDITTEXT        IDC_PICPATH, 10, 20, 216, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 232, 20, 58, 14

    LTEXT           "TV text when nothing is playing:", IDC_STATIC, 10, 42, 220, 10
    EDITTEXT        IDC_IDLETEXT, 10, 54, 120, 14, ES_AUTOHSCROLL
    LTEXT           "(leave empty for a blank screen)", IDC_STATIC, 136, 57, 154, 10

    LTEXT           "Show the room on:", IDC_STATIC, 10, 80, 70, 10
    COMBOBOX        IDC_SCREENMODE, 82, 78, 144, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Identify", IDC_IDENTIFY, 232, 77, 58, 14
    CONTROL         "", IDC_SCREENLIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 96, 280, 48
    LTEXT           "Screens without the room go black. If none of the chosen screens is connected, the main screen is used.", IDC_STATIC, 10, 148, 280, 18

    LTEXT           "Beat sensitivity:", IDC_STATIC, 10, 172, 100, 10
    CONTROL         "", IDC_SENS, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 10, 184, 246, 22
    LTEXT           "1.00", IDC_SENS_VAL, 262, 188, 30, 10

    LTEXT           "Brightness:", IDC_STATIC, 10, 212, 100, 10
    CONTROL         "", IDC_BRIGHT, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 10, 224, 246, 22
    LTEXT           "1.00", IDC_BRIGHT_VAL, 262, 228, 30, 10

    LTEXT           "Album art, glow && beat flicker react to whatever is playing.", IDC_STATIC, 10, 252, 280, 10

    DEFPUSHBUTTON   "OK", IDOK, 176, 268, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 236, 268, 54, 16
END
